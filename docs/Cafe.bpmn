    <bpmn:textAnnotation id="TextAnnotation_1k4wfv4">
      <bpmn:text>через N_NOTIFICATIONS</bpmn:text>
    </bpmn:textAnnotation>
    <bpmn:textAnnotation id="TextAnnotation_1lbfx5i">
      <bpmn:text>Пересчет в S2 (BR 2.3)</bpmn:text>
